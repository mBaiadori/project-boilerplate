{
  "name": "context-os-desktop",
  "version": "1.0.0",
  "description": "Context OS - Spec-Driven Governance & Autonomous AI Platform",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "Context OS Team",
  "license": "Commercial",
  "scripts": {
    "dev": "tsx src/main/index.ts",
    "build:ts": "tsc",
    "compile:bytecode": "node scripts/compile-bytecode.js",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder -mwl"
  },
  "dependencies": {
    "bytenode": "^1.5.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
