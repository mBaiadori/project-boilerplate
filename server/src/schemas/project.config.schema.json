{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectConfig",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "architecture_pattern": { "type": "string" },
        "repository_url": { "type": "string" },
        "lead": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "badge": { "type": "string" }
        }
      }
    },
    "governance_rules": {
      "type": "object",
      "properties": {
        "min_approvals_default": { "type": "number" }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "handle": { "type": "string" },
          "role": { "type": "string" },
          "tier": { "type": "string" }
        }
      }
    },
    "ai_assistant_prompt": { "type": "string" }
  },
  "additionalProperties": true
}
