{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectConfig",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "architecture_pattern": { "type": "string" },
        "repository_url": { "type": "string" },
        "lead": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          },
          {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "badge": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "governance_rules": {
      "type": "object",
      "properties": {
        "min_approvals_default": { "type": "number" }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "handle": { "type": "string" },
          "role": { "type": "string" },
          "tier": { "type": "string" }
        }
      }
    },
    "ai_template_prompt": { "type": "string" }
  },
  "additionalProperties": true
}
