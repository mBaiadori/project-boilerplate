{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectConfig",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "architecture_pattern": { "type": "string" },
        "repository_url": { "type": "string" },
        "lead": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          },
          {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "badge": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        ]
      }
    },
    "governance_rules": {
      "type": "object",
      "properties": {
        "min_approvals_default": { "type": "number" },
        "notifications": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "cooldown_minutes": { "type": "number", "default": 15 },
            "channels": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "provider": { "type": "string", "enum": ["resend", "smtp", "sendgrid"] },
                    "sender_address": { "type": "string" },
                    "sender_name": { "type": "string" }
                  }
                },
                "webhook": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "url": { "type": "string" }
                  }
                }
              }
            },
            "events": {
              "type": "object",
              "properties": {
                "on_quorum_requested": { "type": "boolean", "default": true },
                "on_quorum_approved": { "type": "boolean", "default": true },
                "on_compliance_violation": { "type": "boolean", "default": true },
                "on_clearance_changed": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "handle": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" },
          "tier": { "type": "string" },
          "notify_channels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notify_events": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "ai_template_prompt": { "type": "string" }
  },
  "additionalProperties": true
}
