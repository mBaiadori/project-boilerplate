{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UbiquitousDictionary",
  "type": "object",
  "required": ["terms"],
  "properties": {
    "version": { "type": "string" },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string" },
          "domain": { "type": "string" },
          "category": { "type": "string" },
          "code_name": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "domains": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
