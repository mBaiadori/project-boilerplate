{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocsMetadata",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "ext", "path"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "title": { "type": "string" },
      "ext": { "type": "string" },
      "path": { "type": "string" },
      "status": { "type": "string" },
      "categories": { "type": "string" },
      "tags": {
        "type": "array",
        "items": { "type": "string" }
      },
      "updated_at": { "type": "string" },
      "approvers": {
        "type": "array",
        "items": { "type": "string" }
      },
      "links": {
        "type": "array",
        "items": { "type": "string" }
      },
      "templateId": { "type": "string" },
      "prompt": { "type": "string" }
    },
    "additionalProperties": true
  }
}
